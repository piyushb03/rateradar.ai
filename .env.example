# RateRadar Environment Configuration Example
# Copy to .env for local adjustments (no secrets required for core functionality)

# Anomaly threshold percentage (default 10.0%)
ANOMALY_THRESHOLD_PCT=10.0

# Server Port and Host
HOST=0.0.0.0
PORT=8000

# Permitted CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000

# Max Upload Size in Bytes (default 50MB)
MAX_UPLOAD_SIZE_BYTES=52428800
